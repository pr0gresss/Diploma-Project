# Backend environment variables
# Copy this file to `.env` and fill in real values. Never commit `.env`.

# PostgreSQL connection string
# Required PostgreSQL connection URL; obtain user/password/host/database from your database setup. URL-encode reserved password characters.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/diploma_project?schema=public"

# NestJS HTTP port
# Host backend HTTP port; default 3000.
PORT=3000

# JWT access tokens. The secret must contain at least 32 characters.
# Private signing secret, at least 32 random characters; generate using Node crypto.randomBytes(32).toString("hex").
JWT_SECRET="replace-with-a-random-secret-at-least-32-characters-long"
# JWT issuer claim; keep consistent across backend instances.
JWT_ISSUER="ai-study-workspace"
# JWT audience identifying this API; keep consistent during token validation.
JWT_AUDIENCE="ai-study-workspace-api"
# Access-token lifetime, e.g. 15m; expiration requires signing in again.
JWT_ACCESS_TTL="15m"

# Private object storage root for uploaded materials, extracted text and guides
# Local-driver directory relative to backend working directory; stores documents, extracted text and guides.
STORAGE_ROOT=".storage"

# Storage driver: "local" in development, "s3" for S3 or an S3-compatible store
# local needs no cloud account; s3 requires bucket, region and S3 credentials below.
STORAGE_DRIVER=local

# S3 / Cloudflare R2 (required when STORAGE_DRIVER=s3)
# Exact existing private bucket name from the R2/S3 dashboard; required for s3.
S3_BUCKET="ai-study-workspace"
# Required for s3: auto for R2, bucket region for AWS S3.
S3_REGION="auto"
# Service origin from bucket S3 settings, without bucket/object path; match bucket jurisdiction.
S3_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
# S3 Access Key ID from bucket-scoped Object Read & Write credential creation.
AWS_ACCESS_KEY_ID=
# Matching private S3 Secret Access Key; not a Cloudflare Global API Key or raw API token.
AWS_SECRET_ACCESS_KEY=
# Temporary S3 credentials only; leave empty for ordinary R2 credentials.
# AWS_SESSION_TOKEN="" # only for temporary credentials
#
# For R2 key-creation instructions and connection testing:
# ../Documentation/Backend/Storage/R2_SETUP.md

# OpenAI-compatible provider or separately configured gateway.
# openai for direct compatible API; codex_gateway for a separately running gateway.
LLM_PROVIDER=openai
# API base including /v1. Host gateway: http://127.0.0.1:8317/v1. Docker requires a reachable private address, not container loopback.
LLM_BASE_URL=https://api.openai.com/v1
# Host extraction service endpoint; root Compose supplies http://tika:9998 automatically.
TIKA_URL=http://127.0.0.1:9998
# Extraction request timeout in milliseconds; default 60000.
TIKA_TIMEOUT_MS=60000
# Disable all polling/recovery in scripts and isolated tests.
# true enables extraction polling/recovery; false is for isolated tests/scripts.
PROCESSING_WORKER_ENABLED=true
# Exact model ID from authenticated provider catalog; blank disables generation.
LLM_MODEL=
# Private OpenAI project API key or generated gateway client key; blank disables generation. Gateway OAuth login is separate. See Documentation/Backend/AI/LLM_CONFIGURATION.md.
LLM_API_KEY=
# Provider request timeout in milliseconds; default 45000.
LLM_TIMEOUT_MS=45000
# Source plus prompt/schema character budget, not tokens; oversized input is rejected. Respect model context capacity.
LLM_MAX_CONTEXT_CHARS=60000
# Maximum generated response tokens per request; default 8192.
LLM_MAX_OUTPUT_TOKENS=8192
