{
  "name": "backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "seed:user": "node scripts/seed-user.mjs",
    "build": "nest build",
    "deploy": "nest deploy",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "oxlint --type-aware src/ test/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:services": "npm run build && node scripts/service-smoke.mjs",
    "test:http": "npm run build && node scripts/http-smoke.mjs",
    "test:storage": "npm run build && node scripts/storage-smoke.mjs",
    "test:tika": "npm run build && node scripts/tika-smoke.mjs",
    "test:tika:r2": "npm run build && node scripts/tika-smoke.mjs --r2",
    "test:processing": "npm run build && node scripts/processing-smoke.mjs",
    "docs:generate": "npm run build && node scripts/export-openapi.mjs",
    "docs:check": "npm run build && node scripts/export-openapi.mjs --check && redocly lint --config ../Documentation/Backend/API/redocly.yaml && node scripts/check-openapi.mjs",
    "docs:lint": "redocly lint --config ../Documentation/Backend/API/redocly.yaml",
    "docs:token": "node scripts/docs-token.mjs",
    "ai:login": "npm run build && node scripts/openai-oauth.mjs",
    "ai:models": "npm run build && node scripts/openai-oauth.mjs --models",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:migrate:status": "prisma migrate status",
    "prisma:studio": "prisma studio",
    "ai:gateway:setup": "node scripts/codex-gateway.mjs setup",
    "ai:gateway:start": "node scripts/codex-gateway.mjs start",
    "ai:gateway:login": "node scripts/codex-gateway.mjs login",
    "ai:gateway:check": "node scripts/codex-gateway.mjs check",
    "ai:gateway:model": "node scripts/codex-gateway.mjs model"
  },
  "dependencies": {
    "@nestjs/authentication": "^0.1.7",
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/storage": "^0.0.5",
    "@nestjs/swagger": "^12.1.2",
    "@nestjs/throttler": "^6.8.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "bcryptjs": "^3.0.3",
    "openai": "^7.62.0",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/mau": "^0.2.6",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@redocly/cli": "^2.82.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "dotenv": "^17.4.2",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.4.2",
    "prisma": "^7.10.1",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "^4.1.2"
  }
}
