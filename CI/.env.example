# Copy to CI/.env. Use URL-safe values (hex is recommended) for the database
# password because it is interpolated into DATABASE_URL.
# Required Compose database password; generate random hex for URL-safe interpolation. Changing this does not rotate credentials in an existing database volume.
POSTGRES_PASSWORD=replace-with-a-random-hex-password

# At least 32 random characters. Generate with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Private signing secret, at least 32 random characters; generate using Node crypto.randomBytes(32).toString("hex").
JWT_SECRET=replace-with-a-random-signing-secret-at-least-32-characters

# Change POSTGRES_PORT to 5433 if your host PostgreSQL already uses 5432.
# Published host database port; choose 5433 if 5432 is occupied.
POSTGRES_PORT=5432
# Published host API port; container listens on 3000.
BACKEND_PORT=3000
# openai for direct compatible API; codex_gateway for a separately running gateway.
LLM_PROVIDER=openai
# API base including /v1. Host gateway: http://127.0.0.1:8317/v1. Docker requires a reachable private address, not container loopback.
LLM_BASE_URL=https://api.openai.com/v1
# Exact model ID from authenticated provider catalog; blank disables generation.
LLM_MODEL=
# Private OpenAI project API key or generated gateway client key; blank disables generation. Gateway OAuth login is separate. See Documentation/Backend/AI/LLM_CONFIGURATION.md.
LLM_API_KEY=
# Provider request timeout in milliseconds; default 45000.
LLM_TIMEOUT_MS=45000
# Source plus prompt/schema character budget, not tokens; oversized input is rejected. Respect model context capacity.
LLM_MAX_CONTEXT_CHARS=60000
# Maximum generated response tokens per request; default 8192.
LLM_MAX_OUTPUT_TOKENS=8192
# Published host frontend port; container listens on 8080.
FRONTEND_PORT=8080

# Pin a reviewed version/digest before deployment.
# Tika container image; pin a reviewed version/digest for reproducible deployment.
TIKA_IMAGE=apache/tika:latest-full

# Cloudflare R2 private storage. Set local to run without Cloudflare.
# Fill these values before starting with STORAGE_DRIVER=s3.
# local needs no cloud account; s3 requires bucket, region and S3 credentials below.
STORAGE_DRIVER=s3
# Exact existing private bucket name from the R2/S3 dashboard; required for s3.
S3_BUCKET=ai-study-workspace-private
# Required for s3: auto for R2, bucket region for AWS S3.
S3_REGION=auto
# Service origin from bucket S3 settings, without bucket/object path; match bucket jurisdiction.
S3_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
# S3 Access Key ID from bucket-scoped Object Read & Write credential creation.
AWS_ACCESS_KEY_ID=
# Matching private S3 Secret Access Key; not a Cloudflare Global API Key or raw API token.
AWS_SECRET_ACCESS_KEY=
# Only for temporary credentials; leave empty for normal R2 API tokens.
# Temporary S3 credentials only; leave empty for ordinary R2 credentials.
AWS_SESSION_TOKEN=
